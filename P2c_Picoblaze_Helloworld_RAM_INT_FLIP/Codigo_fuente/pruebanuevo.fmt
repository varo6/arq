  1   0              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  2   0              ; PROGRAMA DE SEGURIDAD CON FSM Y LED DE BLOQUEO
  3   0              ; Mantiene estructura original + Comunicación Hardware
  4   0              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  5   0              
  6   0              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  7   0              ;declaracion de constantes y variables
  8   0              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;                  
  9   0              :CONSTANT   RS232        FF           ; Puerto serie
 10   0              :CONSTANT   FSM_PORT     DD           ; NUEVO: Puerto para hablar con la FSM (Hardware)
 11   0              :CONSTANT   VGA_PORT     EF           ; Puerto para VGA (opcional)
 12   0              
 13   0              ; Puertos de caracteres para el XOR
 14   0              :CONSTANT   CHAR1        FE           
 15   0              :CONSTANT   CHAR2        FD           
 16   0              :CONSTANT   CHAR3        FC           
 17   0              :CONSTANT   CHAR4        FB           
 18   0              :CONSTANT   XOR_RES      FA           ; Resultado del XOR
 19   0              
 20   0              :NAMEREG    S1           TXREG        
 21   0              :NAMEREG    S2           RXREG        
 22   0              :NAMEREG    S3           CONTBIT      
 23   0              :NAMEREG    S4           CONT1        
 24   0              :NAMEREG    S5           CONT2        
 25   0              ;
 26   0              :ADDRESS    00           
 27   0              
 28   0              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 29   0              ; Inicio del programa
 30   0              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 31   0              :DISABLE    INTERRUPT    
 32   1              
 33   1 START        
 34   1              ; --- NUEVO: CHEQUEO DE BLOQUEO (LED) ---
 35   1              ; Antes de imprimir nada, miramos si el hardware nos tiene castigados
 36   1              :INPUT      S0           FSM_PORT     
 37   2              :AND        S0           01           ; Miramos el bit 0 (s_locked)
 38   3              :JUMP       NZ           START        ; Si es 1 (LED encendido), volvemos a empezar (espera)
 39   4              
 40   4              ; --- SI LLEGAMOS AQUI, EL SISTEMA ESTA LIBRE ---
 41   4              
 42   4              ; Instrucciones para la parte1 (Imprimir RAM / Vuestra firma)
 43   4              :LOAD       S7           00           
 44   5 PARTE1       
 45   5              :INPUT      TXREG        S7           
 46   6              :ADD        TXREG        00           
 47   7              :JUMP       Z            PARTE2       ; Si es 00 (fin de cadena), vamos a esperar input
 48   8              :CALL       TRANSMITE    
 49   9              :ADD        S7           01           
 50   A              :JUMP       PARTE1       
 51   B              
 52   B              ; Instrucciones para la parte2 (Bucle de espera de usuario)
 53   B PARTE2       
 54   B              :ENABLE     INTERRUPT    ; Activamos interrupcion para poder escribir
 55   C BUCLE_ESPERA 
 56   C              ; Comprobamos constantemente si el hardware nos bloquea de repente
 57   C              :INPUT      S0           FSM_PORT     
 58   D              :AND        S0           01           
 59   E              :JUMP       NZ           START        ; Si nos bloquean, saltamos al inicio (desactiva int)
 60   F              
 61   F              :JUMP       BUCLE_ESPERA ; Si no, seguimos esperando
 62  10              
 63  10              
 64  10              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 65  10              ; Rutina de recepcion de caracteres
 66  10              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 67  10 RECIBE       
 68  10              :INPUT      RXREG        RS232        
 69  11              :AND        RXREG        80           
 70  12              :JUMP       NZ           RECIBE       
 71  13              :CALL       WAIT_05BIT   
 72  14              
 73  14              :LOAD       CONTBIT      09           
 74  15 NEXT_RX_BIT  
 75  15              :CALL       WAIT_1BIT    
 76  16              :SR0        RXREG        
 77  17              :INPUT      S0           RS232        
 78  18              :AND        S0           80           
 79  19              :OR         RXREG        S0           
 80  1A              :SUB        CONTBIT      01           
 81  1B              :JUMP       NZ           NEXT_RX_BIT  
 82  1C              :RETURN     
 83  1D              
 84  1D              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 85  1D              ; Rutina de transmision de caracteres
 86  1D              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 87  1D TRANSMITE    
 88  1D              :LOAD       S0           00           
 89  1E              :OUTPUT     S0           RS232        
 90  1F              :CALL       WAIT_1BIT    
 91  20              
 92  20              :LOAD       CONTBIT      08           
 93  21 NEXT_TX_BIT  
 94  21              :OUTPUT     TXREG        RS232        
 95  22              :CALL       WAIT_1BIT    
 96  23              :SR0        TXREG        
 97  24              :SUB        CONTBIT      01           
 98  25              :JUMP       NZ           NEXT_TX_BIT  
 99  26              
100  26              :LOAD       S0           FF           
101  27              :OUTPUT     S0           RS232        
102  28              :CALL       WAIT_1BIT    
103  29              :RETURN     
104  2A              
105  2A              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
106  2A              ; Rutinas de Tiempos (Drivers)
107  2A              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
108  2A WAIT_1BIT    :LOAD       CONT1        03           
109  2B ESPERA2      :LOAD       CONT2        22           
110  2C ESPERA1      :SUB        CONT2        01           
111  2D              :JUMP       NZ           ESPERA1      
112  2E              :SUB        CONT1        01           
113  2F              :JUMP       NZ           ESPERA2      
114  30              :RETURN     
115  31              
116  31 WAIT_05BIT   :LOAD       CONT1        03           
117  32 ESPERA4      :LOAD       CONT2        10           
118  33 ESPERA3      :SUB        CONT2        01           
119  34              :JUMP       NZ           ESPERA3      
120  35              :SUB        CONT1        01           
121  36              :JUMP       NZ           ESPERA4      
122  37              :RETURN     
123  38              
124  38              
125  38              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
126  38              ; RUTINA HASHEA (Recibe, Eco, Hash)
127  38              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
128  38 HASHEA       
129  38              :CALL       RECIBE       
130  39              :LOAD       TXREG        RXREG        
131  3A              :CALL       TRANSMITE    
132  3B              :HASHER     RXREG        
133  3C              :RETURN     
134  3D              
135  3D SALTOLINEA   
136  3D              :LOAD       TXREG        0D           ; CR
137  3E              :CALL       TRANSMITE    
138  3F              :LOAD       TXREG        0A           ; LF
139  40              :CALL       TRANSMITE    
140  41              :RETURN     
141  42              
142  42              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
143  42              ; MENSAJES (Mal / Bien)
144  42              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
145  42 RUTINAMAL    
146  42              :CALL       SALTOLINEA   
147  43              :LOAD       TXREG        6D           ; 'm'
148  44              :CALL       TRANSMITE    
149  45              :LOAD       TXREG        61           ; 'a'
150  46              :CALL       TRANSMITE    
151  47              :LOAD       TXREG        6C           ; 'l'
152  48              :CALL       TRANSMITE    
153  49              :JUMP       FIN          
154  4A              
155  4A RUTINABIEN   
156  4A              :CALL       SALTOLINEA   
157  4B              :LOAD       TXREG        62           ; 'b'
158  4C              :CALL       TRANSMITE    
159  4D              :LOAD       TXREG        69           ; 'i'
160  4E              :CALL       TRANSMITE    
161  4F              :LOAD       TXREG        65           ; 'e'
162  50              :CALL       TRANSMITE    
163  51              :LOAD       TXREG        6E           ; 'n'
164  52              :CALL       TRANSMITE    
165  53              :JUMP       FIN          
166  54              
167  54 FIN          
168  54              ; (Opcional) Imprimir el código de error si quieres debug
169  54              ; LOAD    txreg, rxreg
170  54              ; CALL    transmite
171  54              :RETURN     
172  55              
173  55              
174  55              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
175  55              ; RUTINA DE ATENCION A LA INTERRUPCION
176  55              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
177  55 INTERRUP     
178  55              :DISABLE    INTERRUPT    
179  56              
180  56              ; Recibimos y hasheamos los 4 caracteres
181  56              :CALL       HASHEA       
182  57              :OUTPUT     RXREG        FE           
183  58              
184  58              :CALL       HASHEA       
185  59              :OUTPUT     RXREG        FD           
186  5A              
187  5A              :CALL       HASHEA       
188  5B              :OUTPUT     RXREG        FC           
189  5C              
190  5C              :CALL       HASHEA       
191  5D              :OUTPUT     RXREG        FB           
192  5E              
193  5E              :CALL       WAIT_05BIT   
194  5F              
195  5F              ; --- LEER RESULTADO DEL XOR ---
196  5F              :INPUT      RXREG        FA           ; Leemos resultado (00 o FF)
197  60              
198  60              ; --- NUEVO: AVISAR AL HARDWARE ---
199  60              ; Esto es vital: le decimos a la FSM si hemos acertado o fallado
200  60              :OUTPUT     RXREG        FSM_PORT     
201  61              
202  61              ; Tambien lo mandamos al VGA (codigo original)
203  61              :OUTPUT     RXREG        EF           
204  62              
205  62              ; Comprobamos resultado para el usuario
206  62              :OR         RXREG        00           
207  63              :CALL       Z            RUTINABIEN   ; Si es 0 -> Bien
208  64              :CALL       NZ           RUTINAMAL    ; Si no es 0 -> Mal (use CALL NZ para seguridad)
209  65              
210  65              ; Volvemos al start para comprobar si el hardware nos ha bloqueado
211  65              :RETURNI    ENABLE       
212  66              
213  FF              :ADDRESS    FF           
214  FF              :JUMP       INTERRUP     
